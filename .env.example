# Optional. By default the contact form emails inquiries to the address in
# src/content/site.ts through FormSubmit (formsubmit.co), no account needed.
# Set this only to send them somewhere else, for example a Formspree form:
#   VITE_FORM_ENDPOINT=https://formspree.io/f/your-form-id
# Copy this file to .env.local and fill it in.
VITE_FORM_ENDPOINT=
